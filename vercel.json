{
  "rewrites": [
    {
      "source": "/acceso",
      "destination": "https://ib-academy-acceso.nomadmutu.workers.dev/academia"
    },
    {
      "source": "/acceso/:path*",
      "destination": "https://ib-academy-acceso.nomadmutu.workers.dev/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|ico|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
